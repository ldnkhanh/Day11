@model IEnumerable<Day11.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Password)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Branch)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Gender)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsRegular)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BirthDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            string BranchName = "";
            string GenderName = "";
            switch (item.Gender)
            {
                case Gender.Male:
                    GenderName = "Nam";
                    break;
                case Gender.Female:
                    GenderName = "Nữ";
                    break;
                default:
                    GenderName = "Khác";
                    break;
            }
            switch (item.Branch)
            {
                case Branch.IT:
                    BranchName = "CNTT";
                    break;
                case Branch.BE:
                    BranchName = "Kinh tế";
                    break;
                case Branch.CE:
                    BranchName = "Công trình";
                    break;
                case Branch.EE:
                    BranchName = "Điện tử";
                    break;
            }
            <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.Password)
            </td>
            <td>
                @BranchName
            </td>
            <td>
                @GenderName
            </td>
            <td>
                    @(item.IsRegular ? "Chính quy" : "Liên thông")
            </td>
            <td>
                @Html.DisplayFor(model => item.Address)
            </td>
            <td>
                @Html.DisplayFor(model => item.BirthDate)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
